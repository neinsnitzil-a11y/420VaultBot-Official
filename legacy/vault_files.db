CREATE TABLE IF NOT EXISTS vault_files (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    filename TEXT NOT NULL,
    full_path TEXT NOT NULL UNIQUE,
    folder TEXT NOT NULL,
    extension TEXT NOT NULL,
    file_size INTEGER NOT NULL, -- Size in bytes
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    modified_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    checksum TEXT UNIQUE -- MD5/SHA256 for robust duplicate detection and integrity verification
);

-- Indexing for blazing fast search
CREATE INDEX IF NOT EXISTS idx_filename ON vault_files (filename COLLATE NOCASE);
CREATE INDEX IF NOT EXISTS idx_folder ON vault_files (folder COLLATE NOCASE);
CREATE INDEX IF NOT EXISTS idx_extension ON vault_files (extension);