DISCORD_TOKEN=replace_me

# Shared Base44 <-> 420Vault secret. Base44 calls this VAULT_API_SECRET.
# setup_and_start.py generates a cryptographically random value automatically.
VAULT_API_KEY=
# License signing secret is intentionally separate from the website API bearer key.
LICENSE_SIGNING_SECRET=

WEBHOOK_ENABLED=0
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8420
PAYMENT_RETURN_URL=https://discord.com/app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=1

# Base44 / website API. Uses the same listener as payment webhooks.
API_ENABLED=0
# For remote Base44 access, expose this listener only through HTTPS/reverse proxy/tunnel.
# Base44 server-side functions send: Authorization: Bearer <VAULT_API_KEY>

# Google Drive Search (OAuth refresh-token flow; server-side only)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Independent heartbeat/watchdog. On Windows, system sleep is prevented while
# the bot process is running, but the display is still allowed to turn off.
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_PREVENT_SYSTEM_SLEEP=1
